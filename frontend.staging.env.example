# Public values only. These variables are embedded in the frontend build.
VITE_SUPABASE_URL=https://<STAGING_PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<STAGING_ANON_OR_PUBLISHABLE_KEY>
# Must be the public half of the VAPID key pair configured on the staging Edge Function.
VITE_VAPID_PUBLIC_KEY=<STAGING_VAPID_PUBLIC_KEY>
